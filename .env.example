# Contact form — set these in Vercel (Project → Settings → Environment Variables).
# Server only. Never commit a value here.
#
# Resend API key, starts with re_
RESEND_API_KEY=
# Verified sender, e.g. Daniel Osman <hello@danielosman.com>
CONTACT_FROM=
# Inbox that receives enquiries, and the address shown as the mailto fallback
CONTACT_TO=

# Public URL of the voice agent's own web UI. Unset in production for now: the
# contact page then renders no voice entry at all. Local: http://127.0.0.1:3101
NEXT_PUBLIC_VOICE_GATEWAY_URL=
