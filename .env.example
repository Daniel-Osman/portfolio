# Contact form - set these in Vercel (Project Settings - Environment Variables).
# Server only. Never commit a value here.
#
# Resend API key, starts with re_
RESEND_API_KEY=
# Verified sender, e.g. Daniel Osman <hello@danielosman.com>
CONTACT_FROM=
# Inbox that receives enquiries, and the address shown as the mailto fallback
CONTACT_TO=

# The assistant's text chat.
# Turns the floating assistant on. Build-time: 1 enables it, anything else renders nothing at all.
# Unset in production for now, so every page ships exactly as it does today.
NEXT_PUBLIC_ASSISTANT=
# Voice agent base URL for the full-size `talk` overlay. Optional: unset means no talk button.
# Build-time: a change needs a rebuild. Local: http://127.0.0.1:3101
NEXT_PUBLIC_AGENT_URL=

# Assistant route upstream. Server only. Never commit a value here.
# API key for the OpenAI-compatible endpoint below.
ASSISTANT_API_KEY=
# Model name. Default: qwen/qwen3.8-27b
ASSISTANT_MODEL=
# Base URL, no trailing slash. Default: https://api.groq.com/openai/v1
ASSISTANT_BASE_URL=
